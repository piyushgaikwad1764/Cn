def xor(a, b):
    result = ""
    for i in range(1, len(b)):
        result += "0" if a[i] == b[i] else "1"
    return result

def crc(data, key):
    l_key = len(key)
    appended = data + "0" * (l_key - 1)
    temp = appended[:l_key]

    while l_key < len(appended):
        if temp[0] == '1':
            temp = xor(key, temp) + appended[l_key]
        else:
            temp = xor('0' * len(key), temp) + appended[l_key]
        l_key += 1

    if temp[0] == '1':
        temp = xor(key, temp)
    else:
        temp = xor('0' * len(key), temp)

    remainder = temp
    print("CRC Remainder:", remainder)
    print("Transmitted Data:", data + remainder)

